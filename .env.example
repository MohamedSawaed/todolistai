# Copy to .env.local and fill in what you have. Every value is optional:
# without Supabase the app runs in "Local mode"; without an AI key the
# assistant shows a setup notice and everything else still works.

# --- AI assistant (server-side only; never exposed to the browser) ---
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium   # low | medium | high

# --- Supabase (accounts + Postgres with row-level security) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "true" after enabling the Google provider in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
